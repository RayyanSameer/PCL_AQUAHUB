# Server Configuration
PORT=5000
FLASK_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aquahub_db
DB_USER=postgres
DB_PASSWORD=your_password

# Auth / Security
# JWT_SECRET is not currently used but add one if extending auth
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_EXPIRES_IN=24h

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Email (development placeholders)
EMAIL_SERVICE=console
EMAIL_USER=
EMAIL_PASSWORD=

# File uploads
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads
